# Copia este archivo a backend/.env y ajusta los valores reales.
# NUNCA subas .env a Git. Las claves secretas viven solo en tu .env local.

# --- Backend ---
ACS_ENV=development            # development | production (por defecto production; production exige Supabase)
ACS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ACS_MAX_UPLOAD_MB=8
ACS_MAX_CONCURRENT_JOBS=2
ACS_RATE_LIMIT_PER_MINUTE=60
ACS_SIGNED_URL_TTL=3600

# --- Supabase (supabase.com → Project Settings → API) ---
# Si SUPABASE_URL queda vacío y ACS_ENV=development, se usa modo local en memoria (sin persistencia).
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
SUPABASE_SERVICE_ROLE_KEY=sb_secret_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- Motor local (ComfyUI). Requiere workflows/image-generation/workflow_api.json ---
ACS_COMFYUI_ENABLED=false
ACS_COMFYUI_URL=http://127.0.0.1:8188

# --- Nube: Cloudflare Workers AI (FLUX.1 schnell) ---
# Obtén tu Account ID y API Token en dash.cloudflare.com
# El token debe tener permiso: Account → Workers AI → Edit
ACS_CLOUD_ENABLED=true
ACS_CLOUDFLARE_ACCOUNT_ID=TU_CLOUDFLARE_ACCOUNT_ID
ACS_CLOUDFLARE_API_TOKEN=TU_CLOUDFLARE_API_TOKEN
ACS_ALLOW_CLOUD_AUTO=true      # true = "auto" puede usar la nube cuando no hay motor local
ACS_DAILY_CLOUD_LIMIT=50       # tope por usuario y día

# --- Frontend (apps/frontend/.env) ---
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX


# --- Comfy Cloud (video / baile). API experimental: https://docs.comfy.org
# Obten tu API key en https://cloud.comfy.org (suscripcion activa requerida)
COMFY_CLOUD_API_KEY=TU_COMFY_CLOUD_API_KEY
COMFY_CLOUD_BASE_URL=https://cloud.comfy.org

# --- VoiceStudio (local, clonacion/doblaje). Requiere VoiceStudio instalado y corriendo.
# Descarga: https://voicestudio.sh (gratis, sin cuenta ni API key para lo basico)
# ACS_VOICESTUDIO_ENABLED=true
# ACS_VOICESTUDIO_URL=http://localhost:3900
