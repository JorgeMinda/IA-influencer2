# Copia este archivo a .env (backend) y ajusta. Los valores de abajo son ficticios.
# NUNCA subas .env a Git. La clave service_role y los tokens viven solo aquí.

# --- Backend ---
ACS_ENV=development            # development | production (production exige Supabase)
ACS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ACS_MAX_UPLOAD_MB=8
ACS_MAX_CONCURRENT_JOBS=2
ACS_RATE_LIMIT_PER_MINUTE=60
ACS_SIGNED_URL_TTL=3600

# --- Supabase (supabase.com → Project Settings → API) ---
# Si SUPABASE_URL queda vacío y ACS_ENV=development, se usa un modo local en memoria (sin persistencia).
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=pega-aqui-la-anon-key
SUPABASE_SERVICE_ROLE_KEY=pega-aqui-la-service-role-key

# --- Motor local (ComfyUI). Sin validar. Requiere workflows/image-generation/workflow_api.json ---
ACS_COMFYUI_ENABLED=false
ACS_COMFYUI_URL=http://127.0.0.1:8188

# --- Nube: Cloudflare Workers AI (FLUX.1 schnell). Sin validar contra la API real ---
ACS_CLOUD_ENABLED=false
ACS_CLOUDFLARE_ACCOUNT_ID=
ACS_CLOUDFLARE_API_TOKEN=
ACS_ALLOW_CLOUD_AUTO=false      # true = "auto" puede usar la nube cuando no hay motor local
ACS_DAILY_CLOUD_LIMIT=50        # tope por usuario y día (conservador; el cupo gratuito real no está confirmado)

# --- Frontend (apps/frontend/.env) ---
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=pega-aqui-la-anon-key
