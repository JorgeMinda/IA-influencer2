# Copia este archivo a .env y ajusta. Los valores de abajo son ficticios.

# --- Backend ---
ACS_ENV=development
ACS_DATABASE_PATH=data/studio.db
ACS_DATA_DIR=data
# Supabase (producción; dejar vacío para modo desarrollo con SQLite)
ACS_SUPABASE_URL=
ACS_SUPABASE_ANON_KEY=
ACS_SUPABASE_SERVICE_ROLE_KEY=
# Clave de acceso de la API. Si queda vacía, el modo desarrollo solo escucha en 127.0.0.1.
ACS_API_KEY=cambia-esta-clave-larga-y-aleatoria
# Orígenes permitidos para el navegador (separados por coma)
ACS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Límites
ACS_MAX_UPLOAD_MB=8
ACS_MAX_CONCURRENT_JOBS=2
ACS_RATE_LIMIT_PER_MINUTE=60

# --- Motor local (ComfyUI) ---
ACS_COMFYUI_ENABLED=false
ACS_COMFYUI_URL=http://127.0.0.1:8188

# --- Proveedor de nube (adaptador genérico; desactivado por defecto) ---
ACS_CLOUD_ENABLED=false
ACS_CLOUD_PROVIDER=ninguno
ACS_CLOUD_API_KEY=

# --- Frontend ---
VITE_API_BASE_URL=http://127.0.0.1:8000
